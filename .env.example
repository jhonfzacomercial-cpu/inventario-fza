# Conexão com o PostgreSQL (obrigatória)
DATABASE_URL=postgres://usuario:senha@localhost:5432/inventario
# Use "true" em bancos gerenciados que exigem SSL (Render, Railway, Neon, Supabase...)
DATABASE_SSL=false

# Segredo das sessões (obrigatório em produção). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Senha inicial do usuário "Adm" (mínimo 8 caracteres). Usada apenas no PRIMEIRO início,
# quando o usuário é criado; a troca de senha é exigida no primeiro acesso.
ADMIN_INITIAL_PASSWORD=

# Endereço público do sistema (usado nos links enviados pelo WhatsApp). Ex.: https://inventario.grupofza.com.br
# Se vazio, usa o endereço da requisição.
APP_URL=

PORT=3000
NODE_ENV=production
APP_TIMEZONE=America/Sao_Paulo
# Duração da sessão em horas (renovada a cada acesso)
SESSION_HOURS=10
# Cookie "Secure" (somente HTTPS). Padrão: true em produção. Use false se acessar por HTTP na rede local.
# COOKIE_SECURE=false

# ---------- WhatsApp (opcional) — cadastro de equipamentos por mensagem ----------
# Valores obtidos em developers.facebook.com > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App > Configurações > Básico > Chave secreta do aplicativo (valida que as mensagens vêm da Meta)
WHATSAPP_APP_SECRET=
# Texto qualquer que você inventa e repete na tela de configuração do webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
