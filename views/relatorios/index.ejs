<%- include('../partials/top', { titulo: r.titulo }) %>
<% const o = r.opcoes;
   const qsBase = new URLSearchParams(Object.entries(query).filter(([k, v]) => k !== 'formato' && v)).toString();
   const tem = (k) => usa.includes(k); %>
<div class="cabecalho">
  <div><h1>Relatórios</h1><p class="sub"><strong><%= r.titulo %></strong> · <%= r.filtros %></p></div>
  <div class="botoes">
    <a class="btn" href="/relatorios/<%= tipo %>?<%= qsBase %>&formato=pdf"><svg viewBox="0 0 24 24"><path d="M6 2h9l5 5v15H6zm8 1.5V8h4.5zM12 11v5.2l-2.1-2.1-1 1L12 18.3l3.1-3.2-1-1-2.1 2.1V11z"/></svg>Exportar PDF</a>
    <a class="btn" href="/relatorios/<%= tipo %>?<%= qsBase %>&formato=xlsx"><svg viewBox="0 0 24 24"><path d="M6 2h9l5 5v15H6zm8 1.5V8h4.5zM8.5 11l2.3 3.5-2.3 3.5h1.8l1.4-2.3 1.4 2.3h1.8l-2.3-3.5 2.3-3.5h-1.8L11.7 13l-1.4-2z"/></svg>Exportar XLSX</a>
  </div>
</div>

<nav class="abas">
  <% Object.entries(TIPOS).forEach(([k, v]) => { %><a class="<%= k === tipo ? 'ativo' : '' %>" href="/relatorios/<%= k %>"><%= v %></a><% }) %>
</nav>

<form class="cartao filtros" method="get" action="/relatorios/<%= tipo %>">
  <% if (tem('busca')) { %><label class="busca">Buscar<input type="search" name="busca" value="<%= f.busca %>" placeholder="Código, nome ou nº de série"></label><% } %>
  <label>Setor<select name="setor"><option value="">Todos</option><% o.setores.forEach(s => { %><option value="<%= s.id %>" <%= f.setor === s.id ? 'selected' : '' %>><%= s.codigo %> — <%= s.nome %></option><% }) %></select></label>
  <label>Categoria<select name="categoria"><option value="">Todas</option><% o.categorias.forEach(c => { %><option value="<%= c.id %>" <%= f.categoria === c.id ? 'selected' : '' %>><%= c.nome %></option><% }) %></select></label>
  <% if (tem('responsavel')) { %>
  <label>Responsável<input name="responsavel" list="lista-resp" value="<%= f.responsavel %>"></label>
  <datalist id="lista-resp"><% o.responsaveis.forEach(x => { %><option value="<%= x %>"><% }) %></datalist>
  <% } %>
  <% if (tem('estado')) { %>
  <label>Estado<select name="estado"><option value="">Todos</option><% Object.entries(u.ESTADOS).forEach(([k, v]) => { %><option value="<%= k %>" <%= f.estado === k ? 'selected' : '' %>><%= v %></option><% }) %></select></label>
  <% } %>
  <% if (tem('situacao') || tem('situacao_ativa')) { %>
  <label>Situação<select name="situacao">
    <option value="ativos">Todos os ativos</option>
    <% u.SITUACOES_ATIVAS.forEach(k => { %><option value="<%= k %>" <%= f.situacao === k ? 'selected' : '' %>><%= u.SITUACOES[k] %></option><% }) %>
    <% if (tem('situacao')) { %>
    <option value="baixado" <%= f.situacao === 'baixado' ? 'selected' : '' %>>Somente baixados</option>
    <option value="todos" <%= f.situacao === 'todos' ? 'selected' : '' %>>Ativos e baixados</option>
    <% } %>
  </select></label>
  <% } %>
  <% if (tem('periodo')) { %>
  <label>De<input type="date" name="inicio" value="<%= f.inicio %>"></label>
  <label>Até<input type="date" name="fim" value="<%= f.fim %>"></label>
  <% } %>
  <% if (tem('motivo')) { %>
  <label>Motivo<select name="motivo"><option value="">Todos</option><% Object.entries(u.MOTIVOS_BAIXA).forEach(([k, v]) => { %><option value="<%= k %>" <%= f.motivo === k ? 'selected' : '' %>><%= v %></option><% }) %></select></label>
  <% } %>
  <% if (tem('detalhe')) { %>
  <label>Conteúdo<select name="detalhe">
    <option value="completo">Resumo + lista de itens</option>
    <option value="resumo" <%= detalhe === 'resumo' ? 'selected' : '' %>>Somente resumo</option>
  </select></label>
  <% } %>
  <div class="filtros-acoes"><button class="btn primario">Gerar relatório</button><a class="btn" href="/relatorios/<%= tipo %>">Limpar</a></div>
  <% if (tipo === 'geral') { %><p class="dica col-total">O período (De/Até) vale para baixas e transferências. Os totais de itens ativos mostram a posição atual.</p><% } %>
</form>

<div class="kpis">
  <% r.resumo.forEach(x => { %>
  <div class="kpi"><span><%= x.label %></span><strong><%= exp.formatarResumo(x) %></strong></div>
  <% }) %>
</div>

<% r.secoes.forEach(sec => { const cols = sec.colunas.filter(c => c.tela !== false); %>
<section class="cartao sem-pad secao-rel">
  <h2 class="secao-titulo"><%= sec.titulo %></h2>
  <% if (!sec.linhas.length) { %><p class="vazio">Nenhum registro para os filtros aplicados.</p><% } else { %>
  <div class="tabela-wrap"><table class="tabela relatorio <%= sec.grande ? '' : 'compacta' %>">
    <thead><tr><% cols.forEach(c => { %><th class="<%= exp.direita(c) ? 'num' : '' %>"><%= c.titulo %></th><% }) %></tr></thead>
    <tbody>
      <% sec.linhas.forEach(l => { %>
        <% if (l._tipo === 'grupo') { %><tr class="grupo"><td colspan="<%= cols.length %>"><%= l.texto %></td></tr>
        <% } else if (l._tipo === 'subtotal') { %><tr class="subtotal"><td colspan="<%= cols.length %>"><%= l.texto %></td></tr>
        <% } else { %>
        <tr class="<%= l._tipo === 'total' ? 'total' : '' %> <%= l._baixado ? 'baixado' : '' %>"><% cols.forEach(c => { const v = exp.formatar(c, l[c.key]); %>
          <td class="<%= exp.direita(c) ? 'num' : '' %> <%= c.tipo === 'moeda' && l[c.key] === null ? 'sem-valor' : '' %>">
            <% if (c.link && l.id) { %><a class="codigo" href="/equipamentos/<%= l.id %>"><%= v %></a><% } else { %><%= v %><% } %>
            <% if (c.sub) { const extra = c.sub.map(k => l[k]).filter(Boolean).join(' · '); if (extra) { %><small class="linha2"><%= extra %></small><% } } %>
          </td><% }) %></tr>
        <% } %>
      <% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>
<% }) %>
<%- include('../partials/bottom') %>
