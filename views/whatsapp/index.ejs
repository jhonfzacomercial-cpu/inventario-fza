<%- include('../partials/top', { titulo: 'WhatsApp' }) %>
<div class="cabecalho"><div>
  <h1>Cadastro pelo WhatsApp</h1>
  <p class="sub">Usuários com WhatsApp vinculado enviam os dados do equipamento para o número da empresa. O sistema confere, pede confirmação e cadastra com código automático.</p>
</div></div>

<div class="grade-2">
  <section class="cartao">
    <h2>Status da integração</h2>
    <% if (configurado) { %>
      <div class="alerta sucesso">Integração configurada. Mensagens recebidas no webhook são processadas automaticamente.</div>
    <% } else { %>
      <div class="alerta aviso">Integração ainda não configurada. Defina as variáveis abaixo no servidor (veja o passo a passo no README).</div>
    <% } %>
    <ul class="checklist">
      <li class="<%= status.token ? 'ok' : '' %>"><code>WHATSAPP_TOKEN</code> — token de acesso permanente</li>
      <li class="<%= status.phoneId ? 'ok' : '' %>"><code>WHATSAPP_PHONE_NUMBER_ID</code> — ID do número</li>
      <li class="<%= status.appSecret ? 'ok' : '' %>"><code>WHATSAPP_APP_SECRET</code> — chave secreta do app (valida as mensagens)</li>
      <li class="<%= status.verifyToken ? 'ok' : '' %>"><code>WHATSAPP_VERIFY_TOKEN</code> — senha que você inventa para o webhook</li>
      <li class="<%= status.appUrl ? 'ok' : '' %>"><code>APP_URL</code> — endereço público (opcional, para links nas respostas)</li>
    </ul>
    <p class="dica">URL de retorno (webhook) para informar na Meta:</p>
    <p><code class="bloco"><%= webhookUrl %></code></p>
  </section>

  <section class="cartao">
    <div class="cartao-topo"><h2>Números autorizados</h2><a href="/usuarios">Gerenciar em Usuários</a></div>
    <% if (!usuarios.length) { %><p class="vazio">Nenhum usuário com WhatsApp vinculado. Em <a href="/usuarios">Usuários</a>, use “Gerenciar → WhatsApp”.</p><% } else { %>
    <table class="tabela"><tbody>
      <% usuarios.forEach(x => { %><tr class="<%= x.ativo ? '' : 'baixado' %>"><td><strong><%= x.nome %></strong><small class="linha2"><%= x.login %></small></td><td class="mono">+<%= x.whatsapp %></td><td><%= x.ativo ? '' : 'desativado' %></td></tr><% }) %>
    </tbody></table>
    <% } %>
  </section>
</div>

<div class="grade-2">
  <section class="cartao">
    <h2>Testar uma mensagem</h2>
    <p class="dica">Cole uma mensagem para ver como o sistema a interpreta. Nada é cadastrado.</p>
    <form class="formulario" method="post" action="/whatsapp/testar">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <textarea name="texto" rows="12" class="mono"><%= textoTeste || MODELO %></textarea>
      <div class="acoes"><button class="btn primario">Interpretar</button></div>
    </form>
  </section>
  <section class="cartao">
    <h2>Resultado</h2>
    <% if (!teste) { %><p class="vazio">Envie uma mensagem de teste ao lado.</p>
    <% } else if (teste.erros.length) { %>
      <div class="alerta erro"><strong>A mensagem seria recusada:</strong><ul><% teste.erros.forEach(e => { %><li><%= e.replace(/\*/g, '') %></li><% }) %></ul></div>
    <% } else { %>
      <div class="alerta sucesso">Mensagem válida. O usuário receberia este resumo para confirmar com <strong>SIM</strong>:</div>
      <pre class="whats"><%= teste.resumo.replace(/\*/g, '') %></pre>
    <% } %>
    <% if (teste && teste.avisos.length) { %><ul class="dica"><% teste.avisos.forEach(a => { %><li><%= a %></li><% }) %></ul><% } %>
  </section>
</div>

<section class="cartao sem-pad">
  <div class="cartao-topo" style="padding: 16px 20px 0"><h2>Últimas mensagens</h2></div>
  <% if (!mensagens.length) { %><p class="vazio">Nenhuma mensagem trocada ainda.</p><% } else { %>
  <div class="tabela-wrap"><table class="tabela">
    <thead><tr><th>Quando</th><th></th><th>Número</th><th>Usuário</th><th>Mensagem</th><th class="m-ocultar">Status</th></tr></thead>
    <tbody><% mensagens.forEach(m => { %>
      <tr>
        <td class="nowrap"><%= u.dataHora(m.registrado_em) %></td>
        <td><span class="etq <%= m.direcao === 'entrada' ? 'tipo-transferencia' : 'tipo-cadastro' %>"><%= m.direcao === 'entrada' ? 'Recebida' : 'Enviada' %></span></td>
        <td class="mono">+<%= m.telefone %></td>
        <td><%= m.usuario || 'não autorizado' %></td>
        <td><div class="msg-txt"><%= m.texto %></div></td>
        <td class="m-ocultar <%= m.status && m.status.startsWith('erro') ? 'sem-valor' : '' %>"><%= m.status || '' %></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</section>
<%- include('../partials/bottom') %>
